# MongoDB connection string (MongoDB Atlas or local instance)
# Atlas example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/knowledgehub
MONGODB_URI=mongodb://localhost:27017/knowledgehub

# Secret used to sign session cookies - use a long random string in production
SESSION_SECRET=change-me-to-a-long-random-string

# Port the server listens on
PORT=3000

# Set to "production" when hosting (enables secure cookies)
# NODE_ENV=production
