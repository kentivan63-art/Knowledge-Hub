{
  "name": "knowledgehub",
  "version": "1.0.0",
  "description": "KnowledgeHub - Dynamic blog platform on Cloudflare Workers",
  "main": "src/index.js",
  "scripts": {
    "start": "wrangler dev",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create knowledgehub-db",
    "db:migrate:local": "wrangler d1 migrations apply knowledgehub-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply knowledgehub-db --remote",
    "db:seed:local": "wrangler d1 execute knowledgehub-db --local --file=./migrations/seed.sql",
    "db:seed:remote": "wrangler d1 execute knowledgehub-db --remote --file=./migrations/seed.sql",
    "kv:create": "wrangler kv namespace create SESSIONS"
  },
  "keywords": ["blog", "knowledge", "cloudflare-workers", "d1"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2",
    "express-session": "^1.17.3",
    "cors": "^2.8.5",
    "bcryptjs": "^2.4.3"
  },
  "overrides": {
    "iconv-lite": "0.6.3"
  },
  "devDependencies": {
    "wrangler": "^4.0.0",
    "@types/express": "^4.17.21"
  }
}
